# ===== LINE Messaging API =====
# จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# ===== LIFF =====
# จาก LINE Developers Console > LIFF (endpoint = ${BASE_URL}/liff/create.html, size Full)
LIFF_ID=1234567890-abcdefgh

# ===== Server =====
# URL สาธารณะแบบ HTTPS ที่ LINE เข้าถึงได้ (เช่น domain ของ VPS หรือ URL จาก cloudflared tunnel ตอน dev)
BASE_URL=https://your-public-domain.example.com
PORT=3000

# ===== Database =====
# หมายเหตุ: path นี้เทียบกับตำแหน่งไฟล์ prisma/schema.prisma จึงใช้ ../data เพื่อชี้มาที่ data/ ที่ root
DATABASE_URL="file:../data/app.db"

# ===== Scheduler =====
# cron รูปแบบมาตรฐาน (นาที ชั่วโมง วัน เดือน วันในสัปดาห์) — ค่าเริ่มต้น 09:00 ทุกวัน
REMINDER_CRON="0 9 * * *"
TZ=Asia/Bangkok
